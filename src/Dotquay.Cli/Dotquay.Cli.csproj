<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Dotquay.Cli</RootNamespace>
    <AssemblyName>dotquay</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Reported in every JSON envelope (SPEC.md §17) so the editor plugin can tell an older
         dotquay from a newer one before blaming the payload. -->
    <Version>0.18.0</Version>

    <!-- Distribution decision (SPEC.md §12, OQ-6): NativeAOT is the target. Spectre.Console.Cli
         was tried first (§12 OQ-1) but a real `dotnet publish -p:PublishAot=true` build+run proved
         it crashes at startup under NativeAOT (trimmer strips the reflection its command-settings
         binding needs) — see docs/SPRINT-01.md. Swapped to System.CommandLine, the documented
         fallback. -->
    <PublishAot>true</PublishAot>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the suite test the CLI's small pure text helpers (e.g. GraphCommand's NuGet origin line)
         without widening them to public API. -->
    <InternalsVisibleTo Include="Dotquay.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dotquay.Core\Dotquay.Core.csproj" />

    <!-- The `dotquay mcp` subcommand (docs/DESIGN-v0.18-MCP.md) hosts Dotquay.Mcp; that project does
         not reference this one back, so this stays a one-directional edge. -->
    <ProjectReference Include="..\Dotquay.Mcp\Dotquay.Mcp.csproj" />
  </ItemGroup>

</Project>
