<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Dotquay.Core</RootNamespace>
    <AssemblyName>Dotquay.Core</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <!-- IL2026/IL3050 are errors, not warnings: a reflection-based call (Tomlyn's generic
         TomlSerializer.Deserialize<T> was the last one) builds and runs under JIT and fails only in
         the NativeAOT binary. TOML is read through Toml/DotquayTomlContext.cs instead. -->
    <WarningsAsErrors>Nullable;IL2026;IL3050</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- TOML parser/writer for dotquay.toml and dotquay.lock (SPEC.md §12). -->
    <PackageReference Include="Tomlyn" Version="2.3.2" />
    <!-- NuGet.Versioning only (not the full NuGet.Protocol) — see Dotnet/NuGetFlatContainerClient.cs
         for why: NuGet.Protocol's repository-signature check throws under NativeAOT (confirmed via a
         real AOT publish, docs/SPRINT-01.md). NuGet.Versioning is just version parsing/comparison,
         no reflection-based JSON deserialization, and is what NuGetVersionSelector uses to compare
         version strings. -->
    <PackageReference Include="NuGet.Versioning" Version="7.9.0" />
  </ItemGroup>

</Project>
