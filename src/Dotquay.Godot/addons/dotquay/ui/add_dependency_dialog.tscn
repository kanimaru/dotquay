[node name="ModeLabel" type="Label" parent="Root/ModeRow"]
custom_minimum_size = Vector2(76, 0)
layout_mode = 2
tooltip_text = "Which release, branch, or commit to install."
text = "Which version?"

[node name="SourceMode" type="OptionButton" parent="Root/ModeRow"]
