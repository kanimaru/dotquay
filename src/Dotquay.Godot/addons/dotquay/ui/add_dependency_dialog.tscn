[node name="AddDependencyDialog" type="ConfirmationDialog"]
oversampling_override = 1.0
title = "Add a dependency"
position = Vector2i(0, 36)
size = Vector2i(620, 340)
visible = true
wrap_controls = false
ok_button_text = "Add"
script = ExtResource("1_add_dialog")

[node name="Root" type="VBoxContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 8.0
offset_top = 8.0
offset_right = -8.0
offset_bottom = -49.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 10

[node name="KindRow" type="HBoxContainer" parent="Root"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="KindLabel" type="Label" parent="Root/KindRow"]
custom_minimum_size = Vector2(76, 0)
layout_mode = 2
tooltip_text = "Where this dependency comes from. dotquay routes both kinds through the same add."
text = "Source"

[node name="Kind" type="OptionButton" parent="Root/KindRow"]
unique_name_in_owner = true
layout_mode = 2
item_count = 2
popup/item_0/text = "Addon from a git repository (GitHub, GitLab…)"
popup/item_0/id = 0
popup/item_1/text = "C# library from NuGet"
popup/item_1/id = 1

[node name="SourceRow" type="HBoxContainer" parent="Root"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="SourceLabel" type="Label" parent="Root/SourceRow"]
custom_minimum_size = Vector2(76, 0)
layout_mode = 2
tooltip_text = "The git clone URL, or the NuGet package ID."
text = "URL / ID"

[node name="Source" type="LineEdit" parent="Root/SourceRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "https://github.com/nathanhoad/godot_dialogue_manager"

; The mode picker's items are rebuilt per source kind (branch and commit are meaningless for NuGet),
; so they carry ids rather than relying on their index — see add_dependency_dialog.gd.

[node name="ModeRow" type="HBoxContainer" parent="Root"]
unique_name_in_owner = true
layout_mode = 2
