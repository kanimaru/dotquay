grow_vertical = 2
theme_override_constants/separation = 8

; custom_minimum_size.x is a floor, not a width — size_flags_horizontal = EXPAND_FILL means the label
; uses whatever the dialog actually has. It must be non-zero: an autowrapping Label with no declared
; width reports its minimum as "longest word wide, and however many hundred lines that takes".

[node name="Summary" type="Label" parent="Root"]
unique_name_in_owner = true
custom_minimum_size = Vector2(240, 0)
layout_mode = 2
size_flags_horizontal = 3
text = "summary"
autowrap_mode = 3

[node name="ChangesHeading" type="Label" parent="Root"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.58, 0.6, 0.65, 1)
theme_override_font_sizes/font_size = 12
text = "Differences from the locked commit"

; horizontal_scroll_mode = DISABLED, or the wrapping labels inside never wrap: a ScrollContainer that
; can scroll sideways offers its children unbounded width, and an autowrapping Label given unbounded
; width renders one very long line and drags the dialog's minimum size out with it.

[node name="Scroll" type="ScrollContainer" parent="Root"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

